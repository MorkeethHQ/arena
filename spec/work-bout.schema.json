{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arena.local/spec/work-bout.schema.json",
  "title": "ARENA real-work bout",
  "type": "object",
  "required": ["id", "frozen", "acceptance_checks", "runs", "golden_bot"],
  "properties": {
    "id": {"type": "string", "pattern": "^BOUT-[0-9]{3,}$"},
    "frozen": {
      "type": "object",
      "required": ["repository", "revision", "source_tree", "content_fingerprint", "task", "budget"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "source_tree": {"type": "string", "minLength": 1},
        "content_fingerprint": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "task": {"type": "string", "minLength": 1},
        "budget": {
          "type": "object",
          "required": ["wall_clock_seconds", "tool_calls"],
          "properties": {
            "wall_clock_seconds": {"type": "integer", "minimum": 1},
            "tool_calls": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "acceptance_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "path", "contains"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "contains": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "runs": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "setup", "worktree", "action_tape", "observed"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "setup": {
            "type": "object",
            "required": ["model", "system_prompt", "user_prompt", "skills", "memory", "tools", "review_loop", "action_modules"],
            "properties": {
              "model": {"type": "string"},
              "system_prompt": {"type": "string"},
              "user_prompt": {"type": "string"},
              "skills": {"type": "array", "items": {"type": "string"}},
              "memory": {"type": "array", "items": {"type": "string"}},
              "tools": {"type": "array", "items": {"type": "string"}},
              "review_loop": {"type": "string"},
              "action_modules": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": false
          },
          "worktree": {"type": "string", "minLength": 1},
          "action_tape": {"type": "string", "minLength": 1},
          "observed": {
            "type": "object",
            "required": ["elapsed_seconds", "tool_calls", "human_interventions", "auth_stops", "retries", "cost_usd", "commit_receipt"],
            "properties": {
              "elapsed_seconds": {"type": "integer", "minimum": 0},
              "tool_calls": {"type": "integer", "minimum": 0},
              "human_interventions": {"type": "integer", "minimum": 0},
              "auth_stops": {"type": "integer", "minimum": 0},
              "retries": {"type": "integer", "minimum": 0},
              "cost_usd": {"type": ["number", "null"], "minimum": 0},
              "commit_receipt": {"type": ["string", "null"]}
            },
            "additionalProperties": false
          },
          "popularity": {
            "type": "object",
            "properties": {
              "downloads": {"type": ["integer", "null"], "minimum": 0},
              "basis": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "golden_bot": {
      "type": "object",
      "required": ["minimum_distinct_tasks", "require_no_regression"],
      "properties": {
        "minimum_distinct_tasks": {"type": "integer", "minimum": 2},
        "require_no_regression": {"const": true}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
